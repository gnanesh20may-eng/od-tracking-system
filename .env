# Backend environment configuration
# Copy values from .env.example and adapt to your setup

# Database connection string (Postgres)
# e.g. DATABASE_URL=postgres://user:password@localhost:5432/od_system
DATABASE_URL=

# JWT secret for authentication
JWT_SECRET=supersecretkey

# Client URL used to build tracking links
CLIENT_URL=http://localhost:3000

# SMTP settings for email notifications (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Server port
const PORT = 5001;
